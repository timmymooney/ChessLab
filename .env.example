# ChessLab environment configuration
#
# This file is a template only.
# Do not put real secrets or API keys in this file.
#
# Copy this file to .env when you need local configuration:
#
#     cp .env.example .env
#
# The .env file is ignored by Git.

# ========================================
# Chess.com
# ========================================

# Chess.com's public API does not require
# an API key for the initial ChessLab functionality.
#
# CHESSCOM_USERNAME=your_username


# ========================================
# Stockfish
# ========================================

# We will add this when we integrate Stockfish.
#
# STOCKFISH_PATH=/path/to/stockfish


# ========================================
# LLM / NLP
# ========================================

# We will add this when we build the
# natural-language reporting layer.
#
# LLM_API_KEY=your_api_key_here